# AK QIMAASH Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Application ─────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=AK QIMAASH

# ─── Commerce ────────────────────────────────────────────────────────────────
# GST rate as a decimal (9% = 0.09)
VITE_GST_RATE=0.09
# Flat delivery fee in SGD cents (500 = $5.00). Set to 0 for free delivery.
VITE_DELIVERY_FEE_CENTS=500
# Free delivery threshold in SGD cents (10000 = $100.00)
VITE_FREE_DELIVERY_THRESHOLD_CENTS=10000

# ─── Email (Brevo Delivery Configuration) ──────────────────────────────────
# Primary delivery: Supabase Edge Function (send-order-email).
# Resilient Fallback: If edge function is undeployed, client dispatches via Brevo API.
VITE_BREVO_API_KEY=your-brevo-api-key
VITE_BREVO_SENDER_EMAIL=info@akqimaash.com
VITE_BREVO_SENDER_NAME=AK QIMAASH

# ─── Administrative & Security ──────────────────────────────────────────────
# Super admin email with full bypass privileges across all atelier RBAC gates
VITE_SUPER_ADMIN_EMAIL=info@akqimaash.com
# Set to 'true' to enforce MFA for admin roles (optional, defaults to false)
# VITE_MFA_REQUIRED=false

# ─── Supabase Edge Functions Secrets (Set in Supabase Dashboard / CLI) ──────
# These are used by backend Deno edge functions (not exposed to Vite client bundle):
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SMTP_KEY=your-brevo-smtp-key
# EMAIL_FROM_ADDRESS=info@akqimaash.com
# EMAIL_FROM_NAME=AK QIMAASH
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Cloudflare (optional — for build pipeline) ──────────────────────────────
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

